{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "decision-board",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	},
	"vars": {
		"CONVEX_DEPLOYMENT": "dev:unique-pig-692",
		"VITE_CONVEX_URL": "https://unique-pig-692.convex.cloud"
	}
}